# Pool pair + hook used by script/01_CreatePoolAndAddLiquidity, 02_AddLiquidity, 03_Swap, 04_DeployVault.
# Copy to `.env` and override as needed. Foundry loads `.env` automatically.
# TOKEN0 / TOKEN1 / HOOK_CONTRACT defaults live in BaseScript.sol and match these Sepolia addresses.

TOKEN0=0x5a88a2E133251E2F92734e721b13CA6C60De6f09
TOKEN1=0xFbc717e1d5536699afD569860B09aC39C6f16862
HOOK_CONTRACT=0xc727Bf24715514A5C574A001AaC0d7c0eC7EC200

# LendingVault (script/04_DeployVault.s.sol). Defaults live in that script:
# LOAN_TOKEN = Sepolia vdUSD, RELAYER = broadcast sender, VAULT_PREFUND = 1_000_000e18, REPLACE_VAULT = false.
LOAN_TOKEN=0xfe9E69853F0D7488b23CbCA8331E70c351f3bf8e
# RELAYER=0x...
VAULT_PREFUND=1000000000000000000000000
# REPLACE_VAULT=true
